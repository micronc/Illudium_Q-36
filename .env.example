# Copy this file to .env and configure your preferred secrets method.
# Never commit .env to version control.
# Used by local runs and Docker Compose (same names for AWS / GCP inject).

# Optional: sample chat/briefing replies without calling Claude
# DEMO_MODE=true

# --- Option 1: Direct API key (local development) ---
ANTHROPIC_API_KEY=

# Please place your Anthropic API Key behing the equal sign.

# Stable Flask session secret (set a long random value in any real deploy)
FLASK_SECRET_KEY=

# Optional model override
# ANTHROPIC_MODEL=claude-opus-4-6

# USD allocated / loaded onto this API key (shown vs estimated spend in the UI)
# API_BUDGET_USD=25

# Firefox voice input: Web Speech Recognition is unavailable there.
# Recorded audio is transcribed with Whisper if one of these is set:
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Docker Compose host port (container always listens on 8080)
# HOST_PORT=8080

# --- Option 2: HashiCorp Vault (enterprise/production) ---
# Uncomment and configure these to use Vault if you are in a test env and not usng Hashi Vault

# VAULT_ADDR=
## In your VAULT_ADDR make sure that you are putting :8200 at the end of whatevr you use.
# VAULT_TOKEN=
# USE_VAULT=true
